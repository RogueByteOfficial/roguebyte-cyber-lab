# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# RogueByte Cyber Lab - Application Config
# ==========================================
NODE_ENV="development"
PORT="3000"

# Security & Session Secrets (Replace with strong random strings in production)
JWT_SECRET="roguebyte_example_jwt_secret_change_in_production_min_32_chars"
SESSION_SECRET="roguebyte_example_session_secret_change_in_production"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgres://rogue_admin:rogue_secure_password_example@localhost:5432/roguebyte_lab"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="rogue_admin"
DB_PASSWORD="rogue_secure_password_example"
DB_NAME="roguebyte_lab"

# Cache & Background Queue (Redis)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Lab Isolation & Container Orchestrator Settings
LAB_MAX_CONCURRENT_SESSIONS="10"
LAB_SESSION_TIMEOUT_MINUTES="60"
LAB_DOCKER_SOCKET="/var/run/docker.sock"
LAB_ISOLATED_NETWORK_NAME="rogue_lab_net"
LAB_MEMORY_LIMIT="512m"
LAB_CPU_LIMIT="0.5"
LAB_PIDS_LIMIT="100"

# Initial Superadmin Setup (Used during initial seeding)
ADMIN_INITIAL_EMAIL="admin@roguebyte.local"
ADMIN_INITIAL_PASSWORD="change_this_admin_password_upon_first_login_123!"

